# Native development database connection. Docker Compose overrides this internally.
DATABASE_URL=postgresql://himtiadmin:himtiadmin@localhost:5432/himti-internal?schema=public
NODE_ENV=development
PORT=8000
ENABLE_API_DOCS=false

# Generate a unique value for every environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
REGISTRATION_FRONTEND_URL=http://localhost:3001
PRIVATE_UPLOAD_ROOT=/var/lib/himti/private-uploads
# Active AES-256-GCM ticket recovery key version. Keep old versioned keys during rotation.
# Keys are base64-encoded 32-byte values (example generation: openssl rand -base64 32).
TICKET_CREDENTIAL_KEY_VERSION=v1
TICKET_CREDENTIAL_KEY_V1=
# Production fails closed when the configured key is absent/invalid. Development and
# test derive a deterministic local-only fallback from BETTER_AUTH_SECRET.
# Local Docker Compose settings. These credentials are for local development only.
APP_PORT=8000
DB_PORT=5432
DB_USER=himtiadmin
DB_PASSWORD=himtiadmin
DB_NAME=himti-internal
