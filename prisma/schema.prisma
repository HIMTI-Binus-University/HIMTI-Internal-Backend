generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MemberType {
  STUDENT
  LECTURER
  OTHER
}

enum MembershipPosition {
  OFFICER
  STAFF
  MEMBER
}

enum InstitutionType {
  BINUS
  NON_BINUS
}

enum Status {
  ACTIVE
  INACTIVE
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
}

enum StudyProgramStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum SubeventType {
  MAIN_EVENT
  WORKSHOP
  SEMINAR
  COMPETITION
  WELCOMING_PARTY
  DOMESTIC_STUDY_TOUR
  INTERNATIONAL_STUDY_TOUR
  COMPANY_VISIT
  OTHER
}

enum CommitteeRole {
  ADVISOR
  CHAIRPERSON
  VICE_CHAIRPERSON
  SECRETARY
  TREASURER
  COORDINATOR
  STAFF
}

enum SubeventVisibility {
  PUBLIC
  INTERNAL
  INVITE_ONLY // ?
}

enum SubeventStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  SUBMITTED
  VERIFIED
  REJECTED
}

enum RegistrationResponseStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  RADIO
  CHECKBOX
  FILE
}

enum FormQuestionStatus {
  ACTIVE
  INACTIVE
}

enum RegistrationFormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RegistrationMode {
  INTERNAL
  EXTERNAL
  DISABLED
}

enum RegistrationApprovalMode {
  AUTO_APPROVE
  MANUAL_REVIEW
}

enum TicketPackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum RegistrationOrderStatus {
  DRAFT
  AWAITING_MEMBERS
  HOLDING
  SUBMITTED
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PENDING_APPROVAL
  APPROVED
  NEEDS_CORRECTION
  WAITLISTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OrderMemberStatus {
  INVITED
  ACCEPTED
  READY
  CANCELLED
}

enum CapacityHoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum RegistrationFormStage {
  REGISTRATION
  POST_SUBMISSION
  POST_APPROVAL
  POST_REGISTRATION
}

enum RegistrationFormAudience {
  BUYER
  EACH_ATTENDEE
  ALL_ORDER_MEMBERS
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  LOCKED
  NEEDS_CORRECTION
  SUPERSEDED
}

enum OrderPaymentStatus {
  UNPAID
  PROOF_SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentProofStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum PrivateUploadStatus {
  QUARANTINED
  AVAILABLE
  DELETED
}

enum PrivateUploadPurpose {
  PAYMENT_PROOF
}

enum RefundStatus {
  NOT_REQUIRED
  REQUIRED
  PROCESSING
  COMPLETED
  DENIED
}

enum RegistrationInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum TicketStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum LinkWorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum LinkWorkspaceStatus {
  ACTIVE
  ARCHIVED
}

// ==========================================
// ACADEMIC & INSTITUTION
// ==========================================

model University {
  id        String           @id @default(nanoid())
  name      String           @unique @db.VarChar(255)
  shortName String?          @db.VarChar(50)
  status    UniversityStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @db.Timestamp(0)
  updatedAt DateTime?        @updatedAt

  users User[]

  @@map("universities")
}

model StudyProgram {
  id        String             @id @default(nanoid())
  name      String             @unique @db.VarChar(255)
  shortName String?            @db.VarChar(50)
  status    StudyProgramStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamp(0)
  updatedAt DateTime?          @updatedAt

  users User[]

  @@map("study_programs")
}

model Region {
  id        String    @id @default(nanoid())
  name      String    @unique @db.VarChar(255)
  shortName String?   @db.VarChar(50)
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @updatedAt

  users               User[]
  membershipResources MembershipResource[]

  @@map("regions")
}

// ==========================================
// USER & AUTH
// ==========================================

model User {
  // Identity
  id                      String     @id @default(nanoid())
  name                    String     @db.VarChar(255)
  email                   String     @unique @db.VarChar(100)
  emailVerified           Boolean    @default(false)
  outlookEmail            String?    @unique @db.VarChar(100)
  outlookEmailVerified    Boolean    @default(false)
  image                   String?
  status                  UserStatus @default(ACTIVE)
  registrationCompletedAt DateTime?  @db.Timestamp(0)

  // Membership path
  memberType       MemberType?
  institutionType  InstitutionType?
  universityName   String?          @db.VarChar(255)
  studyProgramName String?          @db.VarChar(255)
  department       String?          @db.VarChar(255)
  affiliation      String?          @db.VarChar(255)

  // Academic
  nim            String? @db.VarChar(50)
  universityId   String?
  studyProgramId String?
  regionId       String?
  graduateBatch  String? @db.VarChar(20)

  // Contact
  phoneNumber String? @db.VarChar(20)
  lineId      String? @db.VarChar(50)

  // Audit
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(100)

  // Relations
  university   University?   @relation(fields: [universityId], references: [id])
  studyProgram StudyProgram? @relation(fields: [studyProgramId], references: [id])
  region       Region?       @relation(fields: [regionId], references: [id])

  sessions             Session[]
  accounts             Account[]
  userHasRoles         UserHasRole[]
  eventHasParticipants EventHasParticipant[]

  // Ownership Relations (CreatedBy/UpdatedBy refs)
  createdEvents                       Event[]                          @relation("EventCreator")
  updatedEvents                       Event[]                          @relation("EventUpdater")
  createdSubevents                    Subevent[]                       @relation("SubeventCreator")
  updatedSubevents                    Subevent[]                       @relation("SubeventUpdater")
  createdForms                        RegistrationForm[]               @relation("FormCreator")
  updatedForms                        RegistrationForm[]               @relation("FormUpdater")
  createdQuestions                    FormQuestion[]                   @relation("QuestionCreator")
  updatedQuestions                    FormQuestion[]                   @relation("QuestionUpdater")
  createdOptions                      FormQuestionOption[]             @relation("OptionCreator")
  updatedOptions                      FormQuestionOption[]             @relation("OptionUpdater")
  approvedParticipants                EventHasParticipant[]            @relation("ParticipantApprover")
  verifiedPayments                    EventHasParticipant[]            @relation("PaymentVerifier")
  registrationResponses               RegistrationResponse[]
  eventComittees                      EventComittee[]
  registrationOrders                  RegistrationOrder[]              @relation("RegistrationOrderBuyer")
  registrationMembers                 RegistrationOrderMember[]
  sentEventInvitations                RegistrationInvitation[]         @relation("RegistrationInvitationSender")
  claimedInvitations                  RegistrationInvitation[]         @relation("RegistrationInvitationClaimant")
  reviewedPaymentProofs               RegistrationPaymentProof[]       @relation("RegistrationPaymentProofReviewer")
  reviewedRegistrationPayments        RegistrationPayment[]            @relation("RegistrationPaymentReviewer")
  processedRefunds                    RegistrationRefund[]             @relation("RegistrationRefundProcessor")
  registrationHistory                 RegistrationStatusHistory[]
  attendanceCheckIns                  AttendanceCheckIn[]              @relation("AttendanceCheckInOperator")
  membershipPeriods                   UserMembershipPeriod[]
  createdUrls                         Url[]                            @relation("UrlCreator")
  updatedUrls                         Url[]                            @relation("UrlUpdater")
  createdLinkWorkspaces               LinkWorkspace[]                  @relation("LinkWorkspaceCreator")
  updatedLinkWorkspaces               LinkWorkspace[]                  @relation("LinkWorkspaceUpdater")
  linkWorkspaceMembers                LinkWorkspaceMember[]
  createdWorkspaceLinks               LinkWorkspaceLink[]              @relation("LinkWorkspaceLinkCreator")
  updatedWorkspaceLinks               LinkWorkspaceLink[]              @relation("LinkWorkspaceLinkUpdater")
  createdRoles                        Role[]                           @relation("RoleCreator")
  updatedRoles                        Role[]                           @relation("RoleUpdater")
  createdPermissions                  Permission[]                     @relation("PermissionCreator")
  updatedPermissions                  Permission[]                     @relation("PermissionUpdater")
  updatedUser                         User[]                           @relation("UserUpdater")
  user                                User?                            @relation("UserUpdater", fields: [createdBy], references: [id])
  registrationPaymentHistories        RegistrationPaymentHistory[]
  privateUploads                      PrivateUpload[]
  reopenedPostRegistrationAssignments PostRegistrationFormAssignment[] @relation("PostRegistrationAssignmentReopener")

  @@map("users")
}

model MembershipPeriod {
  id               String  @id @db.VarChar(100)
  label            String  @db.VarChar(100)
  isActive         Boolean @default(false)
  registrationOpen Boolean @default(false)

  memberships UserMembershipPeriod[]
  resources   MembershipResource[]

  @@map("membership_periods")
}

model UserMembershipPeriod {
  userId    String
  periodId  String             @db.VarChar(100)
  joinedAt  DateTime           @default(now()) @db.Timestamp(0)
  isCurrent Boolean            @default(true)
  position  MembershipPosition @default(MEMBER)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  period MembershipPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@id([userId, periodId])
  @@index([userId, isCurrent])
  @@index([periodId])
  @@map("user_membership_periods")
}

model MembershipResource {
  id          String  @id @default(nanoid())
  periodId    String  @db.VarChar(100)
  regionId    String?
  title       String  @db.VarChar(255)
  description String  @db.Text
  url         String? @db.Text
  position    Int     @default(0)

  period MembershipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  region Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([periodId, position])
  @@index([regionId])
  @@map("membership_resources")
}

model Session {
  id        String    @id @default(nanoid())
  token     String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                   String    @id @default(nanoid())
  accountId            String
  providerId           String
  userId               String
  accessToken          String?   @db.Text
  refreshToken         String?   @db.Text
  idToken              String?   @db.Text
  scope                String?   @db.Text
  password             String?   @db.Text
  accessTokenExpiresAt DateTime?
  createdAt            DateTime  @default(now()) @db.Timestamp(0)
  updatedAt            DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(nanoid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// ==========================================
// RBAC (ROLES & PERMISSIONS)
// ==========================================

model Role {
  id        String     @id @default(nanoid())
  roleName  String     @unique @db.VarChar(255)
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @db.Timestamp(0)
  createdBy String     @db.VarChar(100)
  updatedAt DateTime?  @updatedAt
  updatedBy String?    @db.VarChar(100)

  creator User  @relation("RoleCreator", fields: [createdBy], references: [id])
  updater User? @relation("RoleUpdater", fields: [updatedBy], references: [id])

  roleHasUsers       UserHasRole[]
  roleHasPermissions RoleHasPermission[]

  @@map("roles")
}

model Permission {
  id        String    @id @default(nanoid())
  name      String    @unique @db.VarChar(255)
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String    @db.VarChar(100)
  updatedBy String?   @db.VarChar(100)
  updatedAt DateTime? @updatedAt

  permissionHasRoles RoleHasPermission[]
  creator            User                @relation("PermissionCreator", fields: [createdBy], references: [id])
  updater            User?               @relation("PermissionUpdater", fields: [updatedBy], references: [id])

  @@map("permissions")
}

model UserHasRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now()) @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_has_roles")
}

model RoleHasPermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now()) @db.Timestamp(0)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_has_permissions")
}

// ==========================================
// EVENTS & SUBEVENTS
// ==========================================

model Event {
  id                String      @id @default(nanoid())
  name              String      @db.VarChar(255)
  publicDescription String?     @db.Text
  coverImageUrl     String?     @db.Text
  status            EventStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String    @db.VarChar(100)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(100)

  creator User  @relation("EventCreator", fields: [createdBy], references: [id])
  updater User? @relation("EventUpdater", fields: [updatedBy], references: [id])

  subevents            Subevent[]
  eventHasParticipants EventHasParticipant[]
  eventComittees       EventComittee[]
  ticketPackages       TicketPackage[]
  registrationOrders   RegistrationOrder[]
  registrationInvites  RegistrationInvitation[]

  @@map("events")
}

model Subevent {
  id                 String       @id @default(nanoid())
  eventId            String
  name               String       @db.VarChar(255)
  publicDescription  String?      @db.Text
  privateDescription String?      @db.Text
  date               DateTime
  type               SubeventType
  locationName       String?      @db.VarChar(255)
  locationUrl        String?      @db.Text
  posterUrl          String?      @db.Text
  destinationUrl     String?      @db.Text
  position           Int          @default(0)
  price              Int          @default(0)

  // Payment fields
  paid                          Boolean  @default(false)
  paymentAccountBank            String   @db.VarChar(100)
  paymentAccountNumber          Int?
  paymentAccountName            String?  @db.VarChar(100)
  priceModifier                 Int?
  paymentDesc                   String   @db.VarChar(255)
  paymentCurrency               String   @default("IDR") @db.Char(3)
  paymentAmountMinor            BigInt   @default(0)
  paymentBankName               String?  @db.VarChar(100)
  paymentAccountHolder          String?  @db.VarChar(150)
  paymentAccountNumberCanonical String?  @db.VarChar(100)
  paymentInstructions           String?  @db.Text
  paymentProofTypes             String[] @default(["image/jpeg", "image/png", "image/webp", "application/pdf"])
  paymentProofMaxBytes          Int      @default(10485760)

  // Registration Rules
  maxParticipants         Int?
  maxTicketsPerUser       Int?
  isRegistrationOpen      Boolean                  @default(false)
  autoAcceptRegistration  Boolean                  @default(false)
  checkOutToken           String?                  @db.VarChar(255)
  registrationMode        RegistrationMode         @default(DISABLED)
  approvalMode            RegistrationApprovalMode @default(MANUAL_REVIEW)
  registrationOpensAt     DateTime?
  registrationClosesAt    DateTime?
  cancellationClosesAt    DateTime?
  checkoutHoldMinutes     Int                      @default(15)
  memberDeadlineHours     Int                      @default(24)
  paymentDeadlineHours    Int                      @default(24)
  correctionDeadlineHours Int                      @default(24)
  waitlistOfferHours      Int                      @default(24)

  visibility SubeventVisibility @default(PUBLIC)
  status     SubeventStatus     @default(DRAFT)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String    @db.VarChar(100)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(100)

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User  @relation("SubeventCreator", fields: [createdBy], references: [id])
  updater User? @relation("SubeventUpdater", fields: [updatedBy], references: [id])

  participants             EventHasParticipant[]
  registrationForms        RegistrationForm[]
  ticketPackages           TicketPackage[]
  capacityHolds            RegistrationCapacityHold[]
  registrationInvites      RegistrationInvitation[]
  waitlistEntries          RegistrationWaitlistEntry[]
  tickets                  RegistrationTicket[]
  registrationOrders       RegistrationOrder[]
  registrationOrderMembers RegistrationOrderMember[]

  @@unique([id, eventId], map: "subevents_id_eventId_key")
  @@index([eventId, position])
  @@map("subevents")
}

model EventHasParticipant {
  id          String @id @default(nanoid())
  eventId     String
  eventModeId String
  userId      String

  // Status
  registrationStatus RegistrationStatus @default(PENDING)
  approvedAt         DateTime?
  approvedBy         String?            @db.VarChar(100)

  // Payment
  paymentStatus      PaymentStatus @default(UNPAID)
  paymentProofUrl    String?       @db.Text
  paymentSubmittedAt DateTime?
  paymentVerifiedAt  DateTime?
  paymentVerifiedBy  String?       @db.VarChar(100)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @updatedAt

  event    Event    @relation(fields: [eventId], references: [id])
  subevent Subevent @relation(fields: [eventModeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  approver User? @relation("ParticipantApprover", fields: [approvedBy], references: [id])
  verifier User? @relation("PaymentVerifier", fields: [paymentVerifiedBy], references: [id])

  registrationResponses RegistrationResponse[]

  @@unique([eventId, userId, eventModeId])
  @@map("event_has_participants")
}

model EventComittee {
  eventId    String
  userId     String
  role       CommitteeRole @default(STAFF)
  assignedAt DateTime      @default(now()) @db.Timestamp(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_committees")
}

// ==========================================
// REGISTRATION FORM BUILDER
// ==========================================

model RegistrationForm {
  id           String                 @id @default(nanoid())
  subEventId   String
  status       RegistrationFormStatus @default(DRAFT)
  name         String                 @default("Registration") @db.VarChar(255)
  description  String?                @db.Text
  logicalKey   String?                @db.VarChar(100)
  version      Int                    @default(1)
  revision     Int                    @default(1)
  stage        RegistrationFormStage  @default(REGISTRATION)
  publishedAt  DateTime?
  supersedesId String?

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String    @db.VarChar(100)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(100)

  subEvent      Subevent           @relation(fields: [subEventId], references: [id], onDelete: Cascade)
  creator       User               @relation("FormCreator", fields: [createdBy], references: [id])
  updater       User?              @relation("FormUpdater", fields: [updatedBy], references: [id])
  supersedes    RegistrationForm?  @relation("RegistrationFormVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  newerVersions RegistrationForm[] @relation("RegistrationFormVersions")

  questions                   FormQuestion[]
  registrationResponses       RegistrationResponse[]
  sections                    RegistrationFormSection[]
  assignments                 RegistrationFormAssignment[]
  submissions                 RegistrationFormSubmission[]
  postRegistrationAssignments PostRegistrationFormAssignment[]

  @@unique([subEventId, logicalKey, version])
  @@index([subEventId, stage, status])
  @@map("registration_forms")
}

model FormQuestion {
  id                 String             @id @default(nanoid())
  registrationFormId String
  sectionId          String?
  label              String             @db.VarChar(255)
  fieldKey           String             @db.VarChar(100)
  fieldType          FormFieldType
  isRequired         Boolean            @default(true)
  helpText           String?            @db.Text
  validation         Json               @default("{}")
  orderIndex         Int                @default(0)
  status             FormQuestionStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String    @db.VarChar(100)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(100)

  form    RegistrationForm         @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)
  section RegistrationFormSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  creator User                     @relation("QuestionCreator", fields: [createdBy], references: [id])
  updater User?                    @relation("QuestionUpdater", fields: [updatedBy], references: [id])

  options           FormQuestionOption[]
  formAnswers       FormAnswer[]
  submissionAnswers RegistrationFormSubmissionAnswer[]

  @@index([registrationFormId, sectionId, orderIndex])
  @@map("form_questions")
}

model FormQuestionOption {
  id             String  @id @default(nanoid())
  formQuestionId String
  label          String  @db.VarChar(255)
  value          String  @db.VarChar(255)
  isActive       Boolean @default(true)
  orderIndex     Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String    @db.VarChar(100)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(100)

  question        FormQuestion                     @relation(fields: [formQuestionId], references: [id], onDelete: Cascade)
  creator         User                             @relation("OptionCreator", fields: [createdBy], references: [id])
  updater         User?                            @relation("OptionUpdater", fields: [updatedBy], references: [id])
  selectedAnswers RegistrationFormSelectedOption[]

  @@index([formQuestionId, orderIndex])
  @@map("form_question_options")
}

model RegistrationResponse {
  id                    String                     @id @default(nanoid())
  eventHasParticipantId String
  registrationFormId    String
  userId                String
  status                RegistrationResponseStatus @default(DRAFT)
  submittedAt           DateTime?

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @updatedAt

  participant      EventHasParticipant @relation(fields: [eventHasParticipantId], references: [id], onDelete: Cascade)
  registrationForm RegistrationForm    @relation(fields: [registrationFormId], references: [id])
  user             User                @relation(fields: [userId], references: [id])

  answers FormAnswer[]

  @@map("registration_responses")
}

model FormAnswer {
  id                     String  @id @default(nanoid())
  registrationResponseId String
  formQuestionId         String
  value                  String? @db.Text
  selectedOptionValue    String? @db.VarChar(255)
  fileUrl                String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @updatedAt

  response RegistrationResponse @relation(fields: [registrationResponseId], references: [id], onDelete: Cascade)
  question FormQuestion         @relation(fields: [formQuestionId], references: [id])

  @@map("form_answers")
}

// ==========================================
// EVENT REGISTRATION V1
// ==========================================

model TicketPackage {
  id           String              @id @default(nanoid())
  eventId      String
  subEventId   String
  code         String              @db.VarChar(100)
  name         String              @db.VarChar(255)
  description  String?             @db.Text
  status       TicketPackageStatus @default(DRAFT)
  seatCount    Int
  currency     String              @default("IDR") @db.Char(3)
  priceMinor   BigInt
  revision     Int                 @default(1)
  salesStartAt DateTime?
  salesEndAt   DateTime?
  createdAt    DateTime            @default(now()) @db.Timestamp(0)
  updatedAt    DateTime?           @updatedAt

  event           Event                        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  subEvent        Subevent                     @relation(fields: [subEventId], references: [id], onDelete: Restrict)
  orders          RegistrationOrder[]
  formAssignments RegistrationFormAssignment[]
  waitlistEntries RegistrationWaitlistEntry[]

  @@unique([id, eventId, subEventId], map: "ticket_packages_id_eventId_subEventId_key")
  @@unique([subEventId, code])
  @@index([eventId, status])
  @@index([subEventId, status, salesStartAt, salesEndAt])
  @@map("ticket_packages")
}

model RegistrationOrder {
  id                     String                  @id @default(nanoid())
  orderNumber            String                  @unique @db.VarChar(50)
  eventId                String
  subEventId             String
  ticketPackageId        String
  buyerUserId            String
  status                 RegistrationOrderStatus @default(DRAFT)
  revision               Int                     @default(1)
  seatCount              Int
  currency               String                  @default("IDR") @db.Char(3)
  subtotalMinor          BigInt
  totalMinor             BigInt
  idempotencyKey         String?                 @unique @db.VarChar(255)
  idempotencyFingerprint String?                 @db.VarChar(128)
  memberDeadlineAt       DateTime?
  paymentDeadlineAt      DateTime?
  correctionDeadlineAt   DateTime?
  submittedAt            DateTime?
  approvedAt             DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?                 @db.Text
  createdAt              DateTime                @default(now()) @db.Timestamp(0)
  updatedAt              DateTime?               @updatedAt

  event                       Event                            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  subEvent                    Subevent                         @relation(fields: [subEventId], references: [id], onDelete: Restrict)
  ticketPackage               TicketPackage                    @relation(fields: [ticketPackageId], references: [id], onDelete: Restrict)
  buyer                       User                             @relation("RegistrationOrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  members                     RegistrationOrderMember[]
  capacityHolds               RegistrationCapacityHold[]
  submissions                 RegistrationFormSubmission[]
  payment                     RegistrationPayment?
  refund                      RegistrationRefund?
  history                     RegistrationStatusHistory[]
  waitlistEntry               RegistrationWaitlistEntry?
  postRegistrationAssignments PostRegistrationFormAssignment[]
  invitations                 RegistrationInvitation[]

  @@unique([id, eventId, subEventId], map: "registration_orders_id_eventId_subEventId_key")
  @@unique([id, subEventId], map: "registration_orders_id_subEventId_key")
  @@index([eventId, status, createdAt])
  @@index([subEventId, status, createdAt])
  @@index([buyerUserId, createdAt])
  @@index([buyerUserId, subEventId, status])
  @@index([paymentDeadlineAt, status])
  @@map("registration_orders")
}

model RegistrationOrderMember {
  id                  String            @id @default(nanoid())
  registrationOrderId String
  subEventId          String
  userId              String
  status              OrderMemberStatus @default(INVITED)
  isBuyer             Boolean           @default(false)
  position            Int
  invitedAt           DateTime          @default(now()) @db.Timestamp(0)
  acceptedAt          DateTime?
  readyAt             DateTime?
  createdAt           DateTime          @default(now()) @db.Timestamp(0)
  updatedAt           DateTime?         @updatedAt

  order                       RegistrationOrder                @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  subEvent                    Subevent                         @relation(fields: [subEventId], references: [id], onDelete: Restrict)
  user                        User                             @relation(fields: [userId], references: [id], onDelete: Restrict)
  submissions                 RegistrationFormSubmission[]
  ticket                      RegistrationTicket?
  claimedInvitation           RegistrationInvitation?          @relation("RegistrationInvitationMember")
  postRegistrationAssignments PostRegistrationFormAssignment[]

  @@unique([id, subEventId], map: "registration_order_members_id_subEventId_key")
  @@unique([registrationOrderId, userId])
  @@unique([registrationOrderId, position])
  @@index([userId, status])
  @@map("registration_order_members")
}

model RegistrationCapacityHold {
  id                  String             @id @default(nanoid())
  registrationOrderId String
  subEventId          String
  quantity            Int
  status              CapacityHoldStatus @default(ACTIVE)
  expiresAt           DateTime
  consumedAt          DateTime?
  releasedAt          DateTime?
  createdAt           DateTime           @default(now()) @db.Timestamp(0)
  updatedAt           DateTime?          @updatedAt

  order    RegistrationOrder @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  subEvent Subevent          @relation(fields: [subEventId], references: [id], onDelete: Restrict)

  @@index([subEventId, status, expiresAt])
  @@index([registrationOrderId, status])
  @@map("registration_capacity_holds")
}

model RegistrationFormSection {
  id                 String             @id @default(nanoid())
  registrationFormId String
  title              String             @db.VarChar(255)
  description        String?            @db.Text
  orderIndex         Int
  status             FormQuestionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @db.Timestamp(0)
  updatedAt          DateTime?          @updatedAt

  form      RegistrationForm @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)
  questions FormQuestion[]

  @@unique([registrationFormId, orderIndex])
  @@map("registration_form_sections")
}

model RegistrationFormAssignment {
  id                 String                   @id @default(nanoid())
  registrationFormId String
  ticketPackageId    String?
  audience           RegistrationFormAudience
  isRequired         Boolean                  @default(true)
  blocksCheckIn      Boolean                  @default(false)
  orderIndex         Int                      @default(0)
  opensAt            DateTime?
  closesAt           DateTime?
  createdAt          DateTime                 @default(now()) @db.Timestamp(0)
  updatedAt          DateTime?                @updatedAt

  form          RegistrationForm @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)
  ticketPackage TicketPackage?   @relation(fields: [ticketPackageId], references: [id], onDelete: Cascade)

  @@index([ticketPackageId, audience, orderIndex])
  @@map("registration_form_assignments")
}

model RegistrationFormSubmission {
  id                             String                   @id @default(nanoid())
  registrationFormId             String
  registrationOrderId            String
  orderMemberId                  String?
  assignmentAudience             RegistrationFormAudience
  assignmentRequired             Boolean                  @default(true)
  assignmentOrderIndex           Int                      @default(0)
  status                         FormSubmissionStatus     @default(DRAFT)
  revision                       Int                      @default(1)
  submittedAt                    DateTime?
  lockedAt                       DateTime?
  correctionReason               String?                  @db.Text
  correctionDeadlineAt           DateTime?
  responseIdempotencyKey         String?                  @db.VarChar(255)
  responseIdempotencyFingerprint String?                  @db.VarChar(128)
  createdAt                      DateTime                 @default(now()) @db.Timestamp(0)
  updatedAt                      DateTime?                @updatedAt

  form                       RegistrationForm                   @relation(fields: [registrationFormId], references: [id], onDelete: Restrict)
  order                      RegistrationOrder                  @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  orderMember                RegistrationOrderMember?           @relation(fields: [orderMemberId], references: [id], onDelete: Cascade)
  answers                    RegistrationFormSubmissionAnswer[]
  postRegistrationAssignment PostRegistrationFormAssignment?

  @@index([registrationOrderId, status])
  @@index([orderMemberId, status])
  @@index([registrationOrderId, assignmentOrderIndex])
  @@map("registration_form_submissions")
}

model PostRegistrationFormAssignment {
  id                  String                   @id @default(nanoid())
  registrationOrderId String
  registrationFormId  String
  logicalFormKey      String                   @db.VarChar(100)
  orderMemberId       String?
  audience            RegistrationFormAudience
  isRequired          Boolean                  @default(true)
  blocksCheckIn       Boolean                  @default(false)
  orderIndex          Int                      @default(0)
  opensAt             DateTime?
  closesAt            DateTime?
  assignedAt          DateTime                 @default(now()) @db.Timestamp(0)
  responseId          String?                  @unique
  reopenReason        String?                  @db.Text
  reopenDeadlineAt    DateTime?
  reopenedAt          DateTime?
  reopenedBy          String?

  order       RegistrationOrder           @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  form        RegistrationForm            @relation(fields: [registrationFormId], references: [id], onDelete: Restrict)
  orderMember RegistrationOrderMember?    @relation(fields: [orderMemberId], references: [id], onDelete: Cascade)
  response    RegistrationFormSubmission? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  reopener    User?                       @relation("PostRegistrationAssignmentReopener", fields: [reopenedBy], references: [id], onDelete: SetNull)

  @@index([registrationOrderId, orderIndex])
  @@index([orderMemberId, blocksCheckIn])
  @@index([registrationFormId])
  @@map("post_registration_form_assignments")
}

model RegistrationFormSubmissionAnswer {
  id             String    @id @default(nanoid())
  submissionId   String
  formQuestionId String
  textValue      String?   @db.Text
  numberValue    Decimal?  @db.Decimal(30, 10)
  dateValue      DateTime?
  fileUrl        String?   @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamp(0)
  updatedAt      DateTime? @updatedAt

  submission      RegistrationFormSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question        FormQuestion                     @relation(fields: [formQuestionId], references: [id], onDelete: Restrict)
  selectedOptions RegistrationFormSelectedOption[]

  @@unique([submissionId, formQuestionId])
  @@index([formQuestionId])
  @@map("registration_form_submission_answers")
}

model RegistrationFormSelectedOption {
  answerId String
  optionId String

  answer RegistrationFormSubmissionAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option FormQuestionOption               @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([answerId, optionId])
  @@index([optionId])
  @@map("registration_form_selected_options")
}

model RegistrationPayment {
  id                  String             @id @default(nanoid())
  registrationOrderId String             @unique
  status              OrderPaymentStatus @default(UNPAID)
  currency            String             @default("IDR") @db.Char(3)
  amountMinor         BigInt
  bankSnapshot        Json?
  submittedAt         DateTime?
  verifiedAt          DateTime?
  expiresAt           DateTime?
  rejectionReason     String?            @db.Text
  revision            Int                @default(1)
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime           @default(now()) @db.Timestamp(0)
  updatedAt           DateTime?          @updatedAt

  order    RegistrationOrder            @relation(fields: [registrationOrderId], references: [id], onDelete: Restrict)
  reviewer User?                        @relation("RegistrationPaymentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  proofs   RegistrationPaymentProof[]
  history  RegistrationPaymentHistory[]
  refund   RegistrationRefund?

  @@index([status, createdAt])
  @@index([expiresAt, status])
  @@map("registration_payments")
}

model RegistrationPaymentProof {
  id           String             @id @default(nanoid())
  paymentId    String
  fileKey      String             @db.Text
  uploadId     String?            @unique
  status       PaymentProofStatus @default(SUBMITTED)
  reviewedBy   String?
  reviewReason String?            @db.Text
  submittedAt  DateTime           @default(now()) @db.Timestamp(0)
  reviewedAt   DateTime?

  payment  RegistrationPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewer User?               @relation("RegistrationPaymentProofReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  upload   PrivateUpload?      @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@index([paymentId, status, submittedAt])
  @@index([status, submittedAt])
  @@map("registration_payment_proofs")
}

model PrivateUpload {
  id               String               @id @default(nanoid())
  storageKey       String               @unique @db.VarChar(255)
  purpose          PrivateUploadPurpose
  status           PrivateUploadStatus  @default(QUARANTINED)
  ownerUserId      String
  mediaType        String               @db.VarChar(100)
  originalFilename String               @db.VarChar(255)
  sizeBytes        Int
  sha256           String               @db.Char(64)
  createdAt        DateTime             @default(now()) @db.Timestamp(0)
  availableAt      DateTime?
  deletedAt        DateTime?

  owner User                      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  proof RegistrationPaymentProof?

  @@index([ownerUserId, purpose, createdAt])
  @@index([status, createdAt])
  @@map("private_uploads")
}

model RegistrationPaymentHistory {
  id          String              @id @default(nanoid())
  paymentId   String
  fromStatus  OrderPaymentStatus?
  toStatus    OrderPaymentStatus
  actorUserId String?
  reason      String?             @db.Text
  createdAt   DateTime            @default(now()) @db.Timestamp(0)

  payment RegistrationPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@map("registration_payment_history")
}

model RegistrationRefund {
  id                  String       @id @default(nanoid())
  registrationOrderId String       @unique
  paymentId           String       @unique
  status              RefundStatus @default(NOT_REQUIRED)
  amountMinor         BigInt
  reason              String?      @db.Text
  processedBy         String?
  processedAt         DateTime?
  createdAt           DateTime     @default(now()) @db.Timestamp(0)
  updatedAt           DateTime?    @updatedAt

  order     RegistrationOrder   @relation(fields: [registrationOrderId], references: [id], onDelete: Restrict)
  payment   RegistrationPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  processor User?               @relation("RegistrationRefundProcessor", fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("registration_refunds")
}

model RegistrationInvitation {
  id                  String                       @id @default(nanoid())
  eventId             String
  subEventId          String
  email               String                       @db.VarChar(255)
  tokenHash           String                       @unique @db.VarChar(128)
  status              RegistrationInvitationStatus @default(PENDING)
  sentBy              String
  claimedBy           String?
  orderMemberId       String?                      @unique
  registrationOrderId String?
  slotPosition        Int?
  expiresAt           DateTime
  acceptedAt          DateTime?
  createdAt           DateTime                     @default(now()) @db.Timestamp(0)
  updatedAt           DateTime?                    @updatedAt

  event       Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subEvent    Subevent                 @relation(fields: [subEventId], references: [id], onDelete: Cascade)
  sender      User                     @relation("RegistrationInvitationSender", fields: [sentBy], references: [id], onDelete: Restrict)
  claimant    User?                    @relation("RegistrationInvitationClaimant", fields: [claimedBy], references: [id], onDelete: SetNull)
  orderMember RegistrationOrderMember? @relation("RegistrationInvitationMember", fields: [orderMemberId], references: [id], onDelete: SetNull)
  order       RegistrationOrder?       @relation(fields: [registrationOrderId, eventId, subEventId], references: [id, eventId, subEventId], onDelete: Cascade, map: "registration_invitations_order_scope_fkey")

  @@unique([registrationOrderId, slotPosition])
  @@index([eventId, email, status])
  @@index([subEventId, status, expiresAt])
  @@index([registrationOrderId, status])
  @@map("registration_invitations")
}

model RegistrationWaitlistEntry {
  id                  String         @id @default(nanoid())
  registrationOrderId String         @unique
  subEventId          String
  ticketPackageId     String
  status              WaitlistStatus @default(WAITING)
  position            Int
  offeredAt           DateTime?
  offerExpiresAt      DateTime?
  createdAt           DateTime       @default(now()) @db.Timestamp(0)
  updatedAt           DateTime?      @updatedAt

  order         RegistrationOrder @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  subEvent      Subevent          @relation(fields: [subEventId], references: [id], onDelete: Restrict)
  ticketPackage TicketPackage     @relation(fields: [ticketPackageId], references: [id], onDelete: Restrict)

  @@unique([subEventId, position])
  @@index([subEventId, status, createdAt])
  @@index([status, offerExpiresAt])
  @@map("registration_waitlist_entries")
}

model RegistrationTicket {
  id            String       @id @default(nanoid())
  orderMemberId String       @unique
  subEventId    String
  tokenHash     String       @unique @db.VarChar(128)
  status        TicketStatus @default(PENDING)
  issuedAt      DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime     @default(now()) @db.Timestamp(0)
  updatedAt     DateTime?    @updatedAt

  orderMember RegistrationOrderMember @relation(fields: [orderMemberId], references: [id], onDelete: Restrict)
  subEvent    Subevent                @relation(fields: [subEventId], references: [id], onDelete: Restrict)
  checkIn     AttendanceCheckIn?

  @@index([subEventId, status])
  @@index([expiresAt, status])
  @@map("registration_tickets")
}

model AttendanceCheckIn {
  id             String   @id @default(nanoid())
  ticketId       String   @unique
  operatorUserId String
  checkedInAt    DateTime @default(now()) @db.Timestamp(0)
  source         String?  @db.VarChar(100)

  ticket   RegistrationTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  operator User               @relation("AttendanceCheckInOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)

  @@index([operatorUserId, checkedInAt])
  @@map("attendance_check_ins")
}

model RegistrationStatusHistory {
  id                  String   @id @default(nanoid())
  registrationOrderId String
  entityType          String   @db.VarChar(100)
  entityId            String
  fromStatus          String?  @db.VarChar(100)
  toStatus            String   @db.VarChar(100)
  actorUserId         String?
  reason              String?  @db.Text
  metadata            Json?
  createdAt           DateTime @default(now()) @db.Timestamp(0)

  order RegistrationOrder @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  actor User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([registrationOrderId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("registration_status_history")
}

// ==========================================
// URL Shortener
// ==========================================

model Url {
  id          String    @id @default(nanoid())
  shortCode   String    @unique @db.VarChar(100)
  originalUrl String    @db.Text
  expiresAt   DateTime?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @db.Timestamp(0)
  updatedAt   DateTime? @updatedAt

  createdBy String  @db.VarChar(100)
  updatedBy String? @db.VarChar(100)

  creator User  @relation("UrlCreator", fields: [createdBy], references: [id])
  updater User? @relation("UrlUpdater", fields: [updatedBy], references: [id])

  urlDetails    UrlDetail[]
  workspaceLink LinkWorkspaceLink?

  @@map("urls")
}

model LinkWorkspace {
  id          String              @id @default(nanoid())
  name        String              @db.VarChar(255)
  description String?             @db.Text
  status      LinkWorkspaceStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @db.Timestamp(0)
  updatedAt   DateTime?           @updatedAt
  createdBy   String              @db.VarChar(100)
  updatedBy   String?             @db.VarChar(100)

  creator User                  @relation("LinkWorkspaceCreator", fields: [createdBy], references: [id])
  updater User?                 @relation("LinkWorkspaceUpdater", fields: [updatedBy], references: [id])
  members LinkWorkspaceMember[]
  links   LinkWorkspaceLink[]

  @@index([status, createdAt])
  @@map("link_workspaces")
}

model LinkWorkspaceMember {
  workspaceId String
  userId      String
  role        LinkWorkspaceRole
  createdAt   DateTime          @default(now()) @db.Timestamp(0)
  updatedAt   DateTime?         @updatedAt

  workspace LinkWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, role])
  @@map("link_workspace_members")
}

model LinkWorkspaceLink {
  id          String    @id @default(nanoid())
  workspaceId String
  urlId       String    @unique
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @db.Timestamp(0)
  updatedAt   DateTime? @updatedAt
  createdBy   String    @db.VarChar(100)
  updatedBy   String?   @db.VarChar(100)

  workspace LinkWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url       Url           @relation(fields: [urlId], references: [id], onDelete: Restrict)
  creator   User          @relation("LinkWorkspaceLinkCreator", fields: [createdBy], references: [id])
  updater   User?         @relation("LinkWorkspaceLinkUpdater", fields: [updatedBy], references: [id])

  @@index([workspaceId, status, createdAt])
  @@map("link_workspace_links")
}

model UrlDetail {
  id        String   @id @default(nanoid())
  urlId     String
  ip        String?  @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  country   String?  @db.VarChar(255)
  region    String?  @db.VarChar(255)
  city      String?  @db.VarChar(255)
  latitude  Float?
  longitude Float?
  isp       String?  @db.VarChar(255)
  timezone  String?  @db.VarChar(255)
  clickedAt DateTime @default(now()) @db.Timestamp(0)

  url Url @relation(fields: [urlId], references: [id])

  @@map("url_details")
}
