generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MemberType {
  STUDENT
  LECTURER
  OTHER
}

enum MembershipPosition {
  OFFICER
  STAFF
  MEMBER
}

enum InstitutionType {
  BINUS
  NON_BINUS
}

enum Status {
  ACTIVE
  INACTIVE
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
}

enum StudyProgramStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum EventGroupStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum OrganizerRole {
  MANAGER
  ORGANIZER
}

enum TicketPackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum RegistrationFormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum FormQuestionType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  RADIO
  CHECKBOX
  FILE
}

enum RegistrationOrderStatus {
  ASSEMBLING
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  EXPIRED
  CANCELLED
  REJECTED
}

enum RegistrationMemberStatus {
  ACTIVE
  LEFT
  REMOVED
  LOCKED
}

enum CapacityHoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum RegistrationPaymentStatus {
  COLLECTING
  REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  CANCELLED
}

enum RegistrationProofStatus {
  CURRENT
  SUPERSEDED
}

enum RegistrationTicketStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum BundleMembershipAction {
  JOINED
  LEFT
  REMOVED_BY_ORGANIZER
}

enum PrivateUploadStatus {
  QUARANTINED
  AVAILABLE
  DELETED
}

enum PrivateUploadPurpose {
  PAYMENT_PROOF
}

enum LinkWorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum LinkWorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum ElectionStatus {
  DRAFT
  OPEN
  CLOSED
  PUBLISHED
}

// ==========================================
// ACADEMIC & INSTITUTION
// ==========================================

model University {
  id        String           @id @default(nanoid())
  name      String           @unique @db.VarChar(255)
  shortName String?          @db.VarChar(50)
  status    UniversityStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @db.Timestamp(0)
  updatedAt DateTime?        @updatedAt

  users User[]

  @@map("universities")
}

model StudyProgram {
  id        String             @id @default(nanoid())
  name      String             @unique @db.VarChar(255)
  shortName String?            @db.VarChar(50)
  status    StudyProgramStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamp(0)
  updatedAt DateTime?          @updatedAt

  users User[]

  @@map("study_programs")
}

model Region {
  id        String    @id @default(nanoid())
  name      String    @unique @db.VarChar(255)
  shortName String?   @db.VarChar(50)
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @updatedAt

  users               User[]
  membershipResources MembershipResource[]

  @@map("regions")
}

// ==========================================
// USER & AUTH
// ==========================================

model User {
  // Identity
  id                      String     @id @default(nanoid())
  name                    String     @db.VarChar(255)
  email                   String     @unique @db.VarChar(100)
  emailVerified           Boolean    @default(false)
  outlookEmail            String?    @unique @db.VarChar(100)
  outlookEmailVerified    Boolean    @default(false)
  image                   String?
  status                  UserStatus @default(ACTIVE)
  registrationCompletedAt DateTime?  @db.Timestamp(0)

  // Membership path
  memberType       MemberType?
  institutionType  InstitutionType?
  universityName   String?          @db.VarChar(255)
  studyProgramName String?          @db.VarChar(255)
  department       String?          @db.VarChar(255)
  affiliation      String?          @db.VarChar(255)

  // Academic
  nim            String? @db.VarChar(50)
  universityId   String?
  studyProgramId String?
  regionId       String?
  graduateBatch  String? @db.VarChar(20)

  // Contact
  phoneNumber String? @db.VarChar(20)
  lineId      String? @db.VarChar(50)

  // Audit
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String?   @db.VarChar(100)
  updatedAt DateTime? @updatedAt
  updatedBy String?   @db.VarChar(100)

  // Relations
  university   University?   @relation(fields: [universityId], references: [id])
  studyProgram StudyProgram? @relation(fields: [studyProgramId], references: [id])
  region       Region?       @relation(fields: [regionId], references: [id])

  sessions     Session[]
  accounts     Account[]
  userHasRoles UserHasRole[]

  // Event relations are inverse declarations only; they do not alter users.
  createdEvents                  Event[]                     @relation("EventCreator")
  updatedEvents                  Event[]                     @relation("EventUpdater")
  createdEventGroups             EventGroup[]                @relation("EventGroupCreator")
  updatedEventGroups             EventGroup[]                @relation("EventGroupUpdater")
  eventOrganizerAssignments      EventOrganizer[]            @relation("EventOrganizerUser")
  assignedEventOrganizers        EventOrganizer[]            @relation("EventOrganizerAssigner")
  eventGroupOrganizerAssignments EventGroupOrganizer[]       @relation("EventGroupOrganizerUser")
  assignedEventGroupOrganizers   EventGroupOrganizer[]       @relation("EventGroupOrganizerAssigner")
  membershipPeriods              UserMembershipPeriod[]
  createdUrls                    Url[]                       @relation("UrlCreator")
  updatedUrls                    Url[]                       @relation("UrlUpdater")
  createdLinkWorkspaces          LinkWorkspace[]             @relation("LinkWorkspaceCreator")
  updatedLinkWorkspaces          LinkWorkspace[]             @relation("LinkWorkspaceUpdater")
  linkWorkspaceMembers           LinkWorkspaceMember[]
  createdWorkspaceLinks          LinkWorkspaceLink[]         @relation("LinkWorkspaceLinkCreator")
  updatedWorkspaceLinks          LinkWorkspaceLink[]         @relation("LinkWorkspaceLinkUpdater")
  createdRoles                   Role[]                      @relation("RoleCreator")
  updatedRoles                   Role[]                      @relation("RoleUpdater")
  createdPermissions             Permission[]                @relation("PermissionCreator")
  updatedPermissions             Permission[]                @relation("PermissionUpdater")
  updatedUser                    User[]                      @relation("UserUpdater")
  user                           User?                       @relation("UserUpdater", fields: [createdBy], references: [id])
  privateUploads                 PrivateUpload[]
  registrationMembers            RegistrationOrderMember[]
  uploadedPaymentProofs          RegistrationPaymentProof[]  @relation("PaymentProofUploader")
  requestedPaymentCorrections    PaymentCorrectionTarget[]   @relation("PaymentCorrectionRequester")
  operatedAttendanceCheckIns     AttendanceCheckIn[]         @relation("AttendanceOperator")
  attendanceAudits               AttendanceAudit[]
  registrationStatusHistory      RegistrationStatusHistory[]
  bundleMembershipSubjects       BundleMembershipAudit[]     @relation("BundleMembershipSubject")
  bundleMembershipActors         BundleMembershipAudit[]     @relation("BundleMembershipActor")
  createdElections               Election[]                  @relation("ElectionCreator")
  updatedElections               Election[]                  @relation("ElectionUpdater")
  electionParticipations         ElectionParticipation[]

  @@map("users")
}

model MembershipPeriod {
  id               String  @id @db.VarChar(100)
  label            String  @db.VarChar(100)
  isActive         Boolean @default(false)
  registrationOpen Boolean @default(false)

  memberships UserMembershipPeriod[]
  resources   MembershipResource[]

  @@map("membership_periods")
}

model UserMembershipPeriod {
  userId    String
  periodId  String             @db.VarChar(100)
  joinedAt  DateTime           @default(now()) @db.Timestamp(0)
  isCurrent Boolean            @default(true)
  position  MembershipPosition @default(MEMBER)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  period MembershipPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@id([userId, periodId])
  @@index([userId, isCurrent])
  @@index([periodId])
  @@map("user_membership_periods")
}

model MembershipResource {
  id          String  @id @default(nanoid())
  periodId    String  @db.VarChar(100)
  regionId    String?
  title       String  @db.VarChar(255)
  description String  @db.Text
  url         String? @db.Text
  position    Int     @default(0)

  period MembershipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  region Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([periodId, position])
  @@index([regionId])
  @@map("membership_resources")
}

model Session {
  id        String    @id @default(nanoid())
  token     String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                   String    @id @default(nanoid())
  accountId            String
  providerId           String
  userId               String
  accessToken          String?   @db.Text
  refreshToken         String?   @db.Text
  idToken              String?   @db.Text
  scope                String?   @db.Text
  password             String?   @db.Text
  accessTokenExpiresAt DateTime?
  createdAt            DateTime  @default(now()) @db.Timestamp(0)
  updatedAt            DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(nanoid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// ==========================================
// RBAC (ROLES & PERMISSIONS)
// ==========================================

model Role {
  id        String     @id @default(nanoid())
  roleName  String     @unique @db.VarChar(255)
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @db.Timestamp(0)
  createdBy String     @db.VarChar(100)
  updatedAt DateTime?  @updatedAt
  updatedBy String?    @db.VarChar(100)

  creator User  @relation("RoleCreator", fields: [createdBy], references: [id])
  updater User? @relation("RoleUpdater", fields: [updatedBy], references: [id])

  roleHasUsers       UserHasRole[]
  roleHasPermissions RoleHasPermission[]

  @@map("roles")
}

model Permission {
  id        String    @id @default(nanoid())
  name      String    @unique @db.VarChar(255)
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  createdBy String    @db.VarChar(100)
  updatedBy String?   @db.VarChar(100)
  updatedAt DateTime? @updatedAt

  permissionHasRoles RoleHasPermission[]
  creator            User                @relation("PermissionCreator", fields: [createdBy], references: [id])
  updater            User?               @relation("PermissionUpdater", fields: [updatedBy], references: [id])

  @@map("permissions")
}

model UserHasRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now()) @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_has_roles")
}

model RoleHasPermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now()) @db.Timestamp(0)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_has_permissions")
}

// ==========================================
// EVENT FOUNDATION
// ==========================================

model EventGroup {
  id                  String           @id @default(nanoid())
  name                String           @db.VarChar(255)
  publicDescription   String?          @db.Text
  internalDescription String?          @db.Text
  coverImageUrl       String?          @db.Text
  primaryColor        String?          @db.VarChar(20)
  secondaryColor      String?          @db.VarChar(20)
  status              EventGroupStatus @default(DRAFT)
  createdAt           DateTime         @default(now()) @db.Timestamp(0)
  createdBy           String           @db.VarChar(100)
  updatedAt           DateTime?        @updatedAt
  updatedBy           String?          @db.VarChar(100)

  creator    User                  @relation("EventGroupCreator", fields: [createdBy], references: [id])
  updater    User?                 @relation("EventGroupUpdater", fields: [updatedBy], references: [id])
  organizers EventGroupOrganizer[]
  events     Event[]

  @@index([status, createdAt])
  @@map("event_groups")
}

model EventGroupOrganizer {
  eventGroupId String
  userId       String
  role         OrganizerRole @default(ORGANIZER)
  assignedAt   DateTime      @default(now()) @db.Timestamp(0)
  assignedBy   String?

  eventGroup EventGroup @relation(fields: [eventGroupId], references: [id], onDelete: Cascade)
  user       User       @relation("EventGroupOrganizerUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner   User?      @relation("EventGroupOrganizerAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([eventGroupId, userId])
  @@index([userId])
  @@map("event_group_organizers")
}

model Event {
  id                        String      @id @default(nanoid())
  eventGroupId              String?
  name                      String      @db.VarChar(255)
  publicDescription         String?     @db.Text
  internalDescription       String?     @db.Text
  startsAt                  DateTime?
  endsAt                    DateTime?
  locationName              String?     @db.VarChar(255)
  locationAddress           String?     @db.Text
  locationUrl               String?     @db.Text
  coverImageUrl             String?     @db.Text
  primaryColor              String?     @db.VarChar(20)
  secondaryColor            String?     @db.VarChar(20)
  status                    EventStatus @default(DRAFT)
  isRegistrationOpen        Boolean     @default(false)
  registrationOpensAt       DateTime?
  registrationClosesAt      DateTime?
  cancellationClosesAt      DateTime?
  capacity                  Int?
  paymentCurrency           String      @default("IDR") @db.Char(3)
  paymentBankName           String?     @db.VarChar(100)
  paymentAccountNumber      String?     @db.VarChar(100)
  paymentAccountHolder      String?     @db.VarChar(150)
  paymentInstructions       String?     @db.Text
  paymentProofTypes         String[]    @default(["image/jpeg", "image/png", "image/webp", "application/pdf"])
  paymentProofMaxBytes      Int         @default(10485760)
  attendanceEnabled         Boolean     @default(false)
  attendanceCheckoutEnabled Boolean     @default(false)
  createdAt                 DateTime    @default(now()) @db.Timestamp(0)
  createdBy                 String      @db.VarChar(100)
  updatedAt                 DateTime?   @updatedAt
  updatedBy                 String?     @db.VarChar(100)

  eventGroup               EventGroup?                @relation(fields: [eventGroupId], references: [id], onDelete: SetNull)
  creator                  User                       @relation("EventCreator", fields: [createdBy], references: [id])
  updater                  User?                      @relation("EventUpdater", fields: [updatedBy], references: [id])
  organizers               EventOrganizer[]
  ticketPackages           TicketPackage[]
  registrationForms        RegistrationForm[]
  registrationOrders       RegistrationOrder[]
  capacityHolds            RegistrationCapacityHold[]
  tickets                  RegistrationTicket[]
  attendanceCheckIns       AttendanceCheckIn[]
  registrationOrderMembers RegistrationOrderMember[]

  @@index([eventGroupId, status])
  @@index([status, startsAt])
  @@map("events")
}

model EventOrganizer {
  eventId    String
  userId     String
  role       OrganizerRole @default(ORGANIZER)
  assignedAt DateTime      @default(now()) @db.Timestamp(0)
  assignedBy String?

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User  @relation("EventOrganizerUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner User? @relation("EventOrganizerAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_organizers")
}

model TicketPackage {
  id           String              @id @default(nanoid())
  eventId      String
  code         String              @db.VarChar(100)
  name         String              @db.VarChar(255)
  description  String?             @db.Text
  status       TicketPackageStatus @default(DRAFT)
  seatCount    Int
  currency     String              @default("IDR") @db.Char(3)
  priceMinor   BigInt
  salesStartAt DateTime?
  salesEndAt   DateTime?
  createdAt    DateTime            @default(now()) @db.Timestamp(0)
  updatedAt    DateTime?           @updatedAt
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orders       RegistrationOrder[]

  @@unique([eventId, code])
  @@unique([id, eventId])
  @@index([eventId, status, salesStartAt, salesEndAt])
  @@map("ticket_packages")
}

model RegistrationForm {
  id          String                       @id @default(nanoid())
  eventId     String
  name        String                       @db.VarChar(255)
  description String?                      @db.Text
  status      RegistrationFormStatus       @default(DRAFT)
  version     Int                          @default(1)
  publishedAt DateTime?
  createdAt   DateTime                     @default(now()) @db.Timestamp(0)
  updatedAt   DateTime?                    @updatedAt
  event       Event                        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  sections    RegistrationFormSection[]
  submissions RegistrationFormSubmission[]

  @@unique([eventId, version])
  @@index([eventId, status])
  @@map("registration_forms")
}

model RegistrationFormSection {
  id                 String           @id @default(nanoid())
  registrationFormId String
  title              String           @db.VarChar(255)
  description        String?          @db.Text
  orderIndex         Int
  form               RegistrationForm @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)
  questions          FormQuestion[]

  @@unique([registrationFormId, orderIndex])
  @@map("registration_form_sections")
}

model FormQuestion {
  id         String                             @id @default(nanoid())
  sectionId  String
  fieldKey   String                             @db.VarChar(100)
  label      String                             @db.VarChar(255)
  type       FormQuestionType
  isRequired Boolean                            @default(true)
  orderIndex Int
  validation Json                               @default("{}")
  section    RegistrationFormSection            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options    FormQuestionOption[]
  answers    RegistrationFormSubmissionAnswer[]

  @@unique([sectionId, fieldKey])
  @@unique([sectionId, orderIndex])
  @@map("form_questions")
}

model FormQuestionOption {
  id              String                           @id @default(nanoid())
  questionId      String
  label           String                           @db.VarChar(255)
  value           String                           @db.VarChar(255)
  orderIndex      Int
  question        FormQuestion                     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions RegistrationFormSelectedOption[]

  @@unique([questionId, value])
  @@unique([questionId, orderIndex])
  @@map("form_question_options")
}

model RegistrationOrder {
  id                String                      @id @default(nanoid())
  orderNumber       String                      @unique @db.VarChar(50)
  eventId           String
  ticketPackageId   String
  status            RegistrationOrderStatus     @default(ASSEMBLING)
  revision          Int                         @default(1)
  seatCount         Int
  currency          String                      @db.Char(3)
  subtotalMinor     BigInt
  totalMinor        BigInt
  bundleCodeHash    String?                     @unique @db.VarChar(64)
  paymentDeadlineAt DateTime?
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime                    @default(now()) @db.Timestamp(0)
  updatedAt         DateTime?                   @updatedAt
  event             Event                       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketPackage     TicketPackage               @relation(fields: [ticketPackageId, eventId], references: [id, eventId], onDelete: Restrict)
  members           RegistrationOrderMember[]
  capacityHold      RegistrationCapacityHold?
  payment           RegistrationPayment?
  history           RegistrationStatusHistory[]
  membershipAudits  BundleMembershipAudit[]

  @@index([eventId, status, createdAt])
  @@index([ticketPackageId, status])
  @@map("registration_orders")
}

model RegistrationOrderMember {
  id                   String                       @id @default(nanoid())
  registrationOrderId  String
  eventId              String
  userId               String
  status               RegistrationMemberStatus     @default(ACTIVE)
  position             Int
  snapshotName         String?                      @db.VarChar(255)
  snapshotNim          String?                      @db.VarChar(50)
  snapshotOutlookEmail String?                      @db.VarChar(100)
  snapshotEmail        String?                      @db.VarChar(100)
  snapshotUniversity   String?                      @db.VarChar(255)
  snapshotStudyProgram String?                      @db.VarChar(255)
  snapshotRegion       String?                      @db.VarChar(255)
  snapshotPhoneNumber  String?                      @db.VarChar(20)
  snapshotAt           DateTime?
  createdAt            DateTime                     @default(now()) @db.Timestamp(0)
  updatedAt            DateTime?                    @updatedAt
  order                RegistrationOrder            @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  event                Event                        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  submissions          RegistrationFormSubmission[]
  paymentProofs        RegistrationPaymentProof[]
  correctionTargets    PaymentCorrectionTarget[]
  ticket               RegistrationTicket?
  membershipAudits     BundleMembershipAudit[]      @relation("BundleMembershipMember")

  @@unique([registrationOrderId, userId])
  @@unique([registrationOrderId, position])
  @@unique([id, registrationOrderId])
  @@index([eventId, userId, status])
  @@map("registration_order_members")
}

model RegistrationCapacityHold {
  id                  String             @id @default(nanoid())
  registrationOrderId String             @unique
  eventId             String
  quantity            Int
  status              CapacityHoldStatus @default(ACTIVE)
  expiresAt           DateTime
  consumedAt          DateTime?
  releasedAt          DateTime?
  createdAt           DateTime           @default(now()) @db.Timestamp(0)
  order               RegistrationOrder  @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, status, expiresAt])
  @@map("registration_capacity_holds")
}

model RegistrationFormSubmission {
  id                  String                             @id @default(nanoid())
  registrationFormId  String
  registrationOrderId String
  orderMemberId       String
  formVersion         Int
  status              FormSubmissionStatus               @default(DRAFT)
  submittedAt         DateTime?
  lockedAt            DateTime?
  createdAt           DateTime                           @default(now()) @db.Timestamp(0)
  updatedAt           DateTime?                          @updatedAt
  form                RegistrationForm                   @relation(fields: [registrationFormId], references: [id], onDelete: Restrict)
  orderMember         RegistrationOrderMember            @relation(fields: [orderMemberId, registrationOrderId], references: [id, registrationOrderId], onDelete: Cascade)
  answers             RegistrationFormSubmissionAnswer[]

  @@unique([registrationFormId, orderMemberId])
  @@index([registrationOrderId, status])
  @@map("registration_form_submissions")
}

model RegistrationFormSubmissionAnswer {
  id              String                           @id @default(nanoid())
  submissionId    String
  formQuestionId  String
  textValue       String?                          @db.Text
  numberValue     Decimal?                         @db.Decimal(30, 10)
  dateValue       DateTime?
  createdAt       DateTime                         @default(now()) @db.Timestamp(0)
  updatedAt       DateTime?                        @updatedAt
  submission      RegistrationFormSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question        FormQuestion                     @relation(fields: [formQuestionId], references: [id], onDelete: Restrict)
  selectedOptions RegistrationFormSelectedOption[]

  @@unique([submissionId, formQuestionId])
  @@map("registration_form_submission_answers")
}

model RegistrationFormSelectedOption {
  answerId String
  optionId String
  answer   RegistrationFormSubmissionAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option   FormQuestionOption               @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([answerId, optionId])
  @@map("registration_form_selected_options")
}

model RegistrationPayment {
  id                  String                     @id @default(nanoid())
  registrationOrderId String                     @unique
  status              RegistrationPaymentStatus  @default(COLLECTING)
  currency            String                     @db.Char(3)
  amountMinor         BigInt
  bankSnapshot        Json?
  expiresAt           DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime                   @default(now()) @db.Timestamp(0)
  updatedAt           DateTime?                  @updatedAt
  order               RegistrationOrder          @relation(fields: [registrationOrderId], references: [id], onDelete: Restrict)
  proofs              RegistrationPaymentProof[]
  correctionTargets   PaymentCorrectionTarget[]

  @@index([status, expiresAt])
  @@map("registration_payments")
}

model RegistrationPaymentProof {
  id               String                  @id @default(nanoid())
  paymentId        String
  orderMemberId    String
  uploadedByUserId String
  uploadId         String                  @unique
  status           RegistrationProofStatus @default(CURRENT)
  submittedAt      DateTime                @default(now()) @db.Timestamp(0)
  supersededAt     DateTime?
  payment          RegistrationPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderMember      RegistrationOrderMember @relation(fields: [orderMemberId], references: [id], onDelete: Restrict)
  uploader         User                    @relation("PaymentProofUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  upload           PrivateUpload           @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@index([paymentId, orderMemberId, status])
  @@map("registration_payment_proofs")
}

model PaymentCorrectionTarget {
  id                String                  @id @default(nanoid())
  paymentId         String
  orderMemberId     String
  requestedByUserId String
  reason            String                  @db.Text
  requestedAt       DateTime                @default(now()) @db.Timestamp(0)
  deadlineAt        DateTime
  resolvedAt        DateTime?
  payment           RegistrationPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderMember       RegistrationOrderMember @relation(fields: [orderMemberId], references: [id], onDelete: Restrict)
  requester         User                    @relation("PaymentCorrectionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([paymentId, orderMemberId, resolvedAt])
  @@map("payment_correction_targets")
}

model RegistrationTicket {
  id            String                   @id @default(nanoid())
  eventId       String
  orderMemberId String                   @unique
  tokenHash     String                   @unique @db.VarChar(128)
  status        RegistrationTicketStatus @default(ACTIVE)
  issuedAt      DateTime                 @default(now()) @db.Timestamp(0)
  expiresAt     DateTime?
  revokedAt     DateTime?
  event         Event                    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orderMember   RegistrationOrderMember  @relation(fields: [orderMemberId], references: [id], onDelete: Restrict)
  checkIns      AttendanceCheckIn[]

  @@index([eventId, status])
  @@map("registration_tickets")
}

model AttendanceCheckIn {
  id             String             @id @default(nanoid())
  eventId        String
  ticketId       String
  operatorUserId String
  checkedInAt    DateTime           @default(now()) @db.Timestamp(0)
  checkedOutAt   DateTime?
  voidedAt       DateTime?
  revision       Int                @default(1)
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticket         RegistrationTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  operator       User               @relation("AttendanceOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  audits         AttendanceAudit[]

  @@index([eventId, checkedInAt])
  @@index([ticketId, voidedAt])
  @@map("attendance_check_ins")
}

model AttendanceAudit {
  id                  String            @id @default(nanoid())
  attendanceCheckInId String
  actorUserId         String
  action              String            @db.VarChar(50)
  reason              String?           @db.Text
  metadata            Json?
  createdAt           DateTime          @default(now()) @db.Timestamp(0)
  checkIn             AttendanceCheckIn @relation(fields: [attendanceCheckInId], references: [id], onDelete: Restrict)
  actor               User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([attendanceCheckInId, createdAt])
  @@map("attendance_audits")
}

model RegistrationStatusHistory {
  id                  String            @id @default(nanoid())
  registrationOrderId String
  actorUserId         String?
  entityType          String            @db.VarChar(50)
  entityId            String
  fromStatus          String?           @db.VarChar(50)
  toStatus            String            @db.VarChar(50)
  reason              String?           @db.Text
  createdAt           DateTime          @default(now()) @db.Timestamp(0)
  order               RegistrationOrder @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  actor               User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([registrationOrderId, createdAt])
  @@map("registration_status_history")
}

model BundleMembershipAudit {
  id                  String                   @id @default(nanoid())
  registrationOrderId String
  orderMemberId       String?
  subjectUserId       String
  actorUserId         String
  action              BundleMembershipAction
  reason              String?                  @db.Text
  createdAt           DateTime                 @default(now()) @db.Timestamp(0)
  order               RegistrationOrder        @relation(fields: [registrationOrderId], references: [id], onDelete: Cascade)
  orderMember         RegistrationOrderMember? @relation("BundleMembershipMember", fields: [orderMemberId], references: [id], onDelete: SetNull)
  subject             User                     @relation("BundleMembershipSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor               User                     @relation("BundleMembershipActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([registrationOrderId, createdAt])
  @@map("bundle_membership_audits")
}

model PrivateUpload {
  id               String               @id @default(nanoid())
  storageKey       String               @unique @db.VarChar(255)
  purpose          PrivateUploadPurpose
  status           PrivateUploadStatus  @default(QUARANTINED)
  ownerUserId      String
  mediaType        String               @db.VarChar(100)
  originalFilename String               @db.VarChar(255)
  sizeBytes        Int
  sha256           String               @db.Char(64)
  createdAt        DateTime             @default(now()) @db.Timestamp(0)
  availableAt      DateTime?
  deletedAt        DateTime?

  owner         User                       @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  paymentProofs RegistrationPaymentProof[]

  @@index([ownerUserId, purpose, createdAt])
  @@index([status, createdAt])
  @@map("private_uploads")
}

// ==========================================
// URL Shortener
// ==========================================

model Url {
  id          String    @id @default(nanoid())
  shortCode   String    @unique @db.VarChar(100)
  originalUrl String    @db.Text
  expiresAt   DateTime?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @db.Timestamp(0)
  updatedAt   DateTime? @updatedAt

  createdBy String  @db.VarChar(100)
  updatedBy String? @db.VarChar(100)

  creator User  @relation("UrlCreator", fields: [createdBy], references: [id])
  updater User? @relation("UrlUpdater", fields: [updatedBy], references: [id])

  urlDetails    UrlDetail[]
  workspaceLink LinkWorkspaceLink?

  @@map("urls")
}

model LinkWorkspace {
  id          String              @id @default(nanoid())
  name        String              @db.VarChar(255)
  description String?             @db.Text
  status      LinkWorkspaceStatus @default(ACTIVE)
  createdAt   DateTime            @default(now()) @db.Timestamp(0)
  updatedAt   DateTime?           @updatedAt
  createdBy   String              @db.VarChar(100)
  updatedBy   String?             @db.VarChar(100)

  creator User                  @relation("LinkWorkspaceCreator", fields: [createdBy], references: [id])
  updater User?                 @relation("LinkWorkspaceUpdater", fields: [updatedBy], references: [id])
  members LinkWorkspaceMember[]
  links   LinkWorkspaceLink[]

  @@index([status, createdAt])
  @@map("link_workspaces")
}

model LinkWorkspaceMember {
  workspaceId String
  userId      String
  role        LinkWorkspaceRole
  createdAt   DateTime          @default(now()) @db.Timestamp(0)
  updatedAt   DateTime?         @updatedAt

  workspace LinkWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, role])
  @@map("link_workspace_members")
}

model LinkWorkspaceLink {
  id          String    @id @default(nanoid())
  workspaceId String
  urlId       String    @unique
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @db.Timestamp(0)
  updatedAt   DateTime? @updatedAt
  createdBy   String    @db.VarChar(100)
  updatedBy   String?   @db.VarChar(100)

  workspace LinkWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url       Url           @relation(fields: [urlId], references: [id], onDelete: Restrict)
  creator   User          @relation("LinkWorkspaceLinkCreator", fields: [createdBy], references: [id])
  updater   User?         @relation("LinkWorkspaceLinkUpdater", fields: [updatedBy], references: [id])

  @@index([workspaceId, status, createdAt])
  @@map("link_workspace_links")
}

model UrlDetail {
  id        String   @id @default(nanoid())
  urlId     String
  ip        String?  @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  country   String?  @db.VarChar(255)
  region    String?  @db.VarChar(255)
  city      String?  @db.VarChar(255)
  latitude  Float?
  longitude Float?
  isp       String?  @db.VarChar(255)
  timezone  String?  @db.VarChar(255)
  clickedAt DateTime @default(now()) @db.Timestamp(0)

  url Url @relation(fields: [urlId], references: [id])

  @@map("url_details")
}

// ==========================================
// ELECTIONS
// ==========================================

model Election {
  id          String         @id @default(nanoid())
  slug        String         @unique @db.VarChar(100)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  status      ElectionStatus @default(DRAFT)
  startsAt    DateTime       @db.Timestamp(0)
  endsAt      DateTime       @db.Timestamp(0)
  debateAt    DateTime?      @db.Timestamp(0)
  openedAt    DateTime?      @db.Timestamp(0)
  closedAt    DateTime?      @db.Timestamp(0)
  publishedAt DateTime?      @db.Timestamp(0)
  createdAt   DateTime       @default(now()) @db.Timestamp(0)
  createdBy   String         @db.VarChar(100)
  updatedAt   DateTime?      @updatedAt
  updatedBy   String?        @db.VarChar(100)

  creator        User                    @relation("ElectionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater        User?                   @relation("ElectionUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  candidates     ElectionCandidate[]
  participations ElectionParticipation[]
  ballots        ElectionBallot[]

  @@index([status, startsAt])
  @@map("elections")
}

model ElectionCandidate {
  id           String    @id @default(nanoid())
  electionId   String
  ballotNumber Int
  name         String    @db.VarChar(255)
  photoUrl     String?   @db.Text
  biography    String?   @db.Text
  slogan       String?   @db.Text
  vision       String    @db.Text
  mission      String    @db.Text
  videoUrl     String?   @db.Text
  workPrograms String[]  @default([])
  experiences  String[]  @default([])
  position     Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamp(0)
  updatedAt    DateTime? @updatedAt

  election Election         @relation(fields: [electionId], references: [id], onDelete: Restrict)
  ballots  ElectionBallot[]

  @@unique([electionId, ballotNumber])
  @@unique([id, electionId])
  @@index([electionId, isActive, position])
  @@map("election_candidates")
}

model ElectionParticipation {
  electionId  String
  userId      String
  receiptCode String   @unique @db.VarChar(64)
  votedAt     DateTime @default(now()) @db.Timestamp(0)

  election Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([electionId, userId])
  @@index([userId])
  @@map("election_participations")
}

model ElectionBallot {
  id          String @id @default(nanoid())
  electionId  String
  candidateId String

  election  Election          @relation(fields: [electionId], references: [id], onDelete: Restrict)
  candidate ElectionCandidate @relation(fields: [candidateId, electionId], references: [id, electionId], onDelete: Restrict)

  @@index([electionId])
  @@index([candidateId])
  @@map("election_ballots")
}
